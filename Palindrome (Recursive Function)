#include <stdio.h>
#include <string.h>

// Recursive function to check if a string is a palindrome
int isPalindrome(char str[], int start, int end) {
    // Base case 1: If the start index has crossed or met the end index,
    // it means all characters have been successfully compared, so it's a palindrome.
    if (start >= end) {
        return 1; // True
    }

    // Base case 2: If the characters at the current start and end positions do not match,
    // the string is not a palindrome.
    if (str[start] != str[end]) {
        return 0; // False
    }

    // Recursive call: Move inwards by incrementing start and decrementing end,
    // and check the remaining substring.
    return isPalindrome(str, start + 1, end - 1);
}

int main() {
    char str[100]; // Declare a character array to store the input string

    printf("Enter a string: ");
    scanf("%s", str); // Read the string from the user

    // Call the recursive function with the initial start (0) and end (strlen(str) - 1) indices
    if (isPalindrome(str, 0, strlen(str) - 1)) {
        printf("\"%s\" is a palindrome.\n", str);
    } else {
        printf("\"%s\" is not a palindrome.\n", str);
    }

    return 0;
}